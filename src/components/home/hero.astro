---
import { Tagline } from "./tagline";
---

<section class="hero">
  <img src="/images/avatar.webp" alt="Avatar" />
  <h1>Maze Heart</h1>
  <p><Tagline client:load /></p>
</section>

<style>
  .hero {
    padding: 180px 0 90px;

    & img {
      display: block;
      width: 36px;
      aspect-ratio: 1/1;
      border-radius: 50%;
      border: 1px solid var(--color-neutral-200);
      margin-bottom: 32px;
    }

    & h1 {
      font-weight: 500;
      margin-bottom: 4px;
    }

    & p {
      color: var(--color-foreground-subtle);
    }
  }
</style>
