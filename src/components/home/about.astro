---
import Section from "../section.astro";

const links = [
  {
    label: "GitHub",
    url: "https://github.com/remvze",
  },
  {
    label: "X (Twitter)",
    url: "https://x.com/remvze",
  },
  {
    label: "Instagram",
    url: "https://instagram.com/remvze",
  },
];
---

<Section title="About">
  <p class="text">
    I'm an independent design engineer, founder, and AI explorer. I spend my
    days crafting elegant interfaces and my nights pushing the boundaries of
    what’s possible with <a href="/ai">generative AI</a>.
  </p>

  <p class="text">
    Currently founder @ <a href="https://philosophors.com">Philosophors</a>.
  </p>

  <div class="links">
    {links.map((link) => <a href={link.url}>{link.label}</a>)}
  </div>
</Section>

<style>
  .text {
    color: var(--color-foreground-subtle);

    &:not(:last-of-type) {
      margin-bottom: 20px;
    }

    & a {
      color: var(--color-foreground);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-decoration-color: var(--color-foreground-subtler);
      text-underline-offset: 4px;
      font-weight: 500;
    }
  }

  .links {
    display: flex;
    column-gap: 12px;
    row-gap: 8px;
    flex-wrap: wrap;
    margin-top: 32px;

    & a {
      color: var(--color-foreground);
      text-decoration: underline;
      text-decoration-style: dotted;
      text-decoration-color: var(--color-foreground-subtler);
      text-underline-offset: 4px;
      font-size: var(--font-sm);
      font-weight: 500;
    }
  }
</style>
